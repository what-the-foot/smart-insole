# Copy this file to .env and replace every placeholder before local use.
MYSQL_DATABASE=smart_insole
MYSQL_USER=smart_insole
MYSQL_PASSWORD=replace-with-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3306

BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3306/smart_insole?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&rewriteBatchedStatements=true
DB_USERNAME=smart_insole
DB_PASSWORD=replace-with-local-db-password
JWT_SECRET=replace-with-at-least-32-random-characters
RECEIVER_API_KEY=replace-with-a-random-receiver-key
CORS_ALLOWED_ORIGINS=http://localhost:5173

VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# Local-profile seed account: created once at backend startup when both values are set and the email is new.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-local-only-password
SEED_ADMIN_NAME=Admin
